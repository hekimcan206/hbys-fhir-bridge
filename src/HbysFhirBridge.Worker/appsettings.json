{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "Bridge": {
    "SourceSchema": "HBYS",
    "BridgeUser": "HBYS_BRIDGE",
    "Pipeline": "fhir",
    "FhirBaseUrl": "http://localhost:18480/fhir/",
    "BatchSize": 500,
    "MaxBundleEntries": 250,
    "PollInterval": "00:00:02",
    "IncludeNationalId": false
  },
  "AllowedHosts": "*"
}
