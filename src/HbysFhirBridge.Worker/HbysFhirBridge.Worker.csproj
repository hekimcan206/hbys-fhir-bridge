<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>The bridge process: continuous sync loop with health and status endpoints, plus install, seed, workload and verify commands.</Description>
    <AssemblyName>hbys-fhir-bridge</AssemblyName>
    <RootNamespace>HbysFhirBridge.Worker</RootNamespace>
    <!-- The chiseled runtime image ships without ICU; invariant mode keeps behaviour identical locally and in the container. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HbysFhirBridge.Core\HbysFhirBridge.Core.csproj" />
    <ProjectReference Include="..\HbysFhirBridge.Synthetic\HbysFhirBridge.Synthetic.csproj" />
    <ProjectReference Include="..\HbysFhirBridge.Oracle\HbysFhirBridge.Oracle.csproj" />
    <ProjectReference Include="..\HbysFhirBridge.Fhir\HbysFhirBridge.Fhir.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HbysFhirBridge.UnitTests" />
    <InternalsVisibleTo Include="HbysFhirBridge.IntegrationTests" />
  </ItemGroup>

</Project>
